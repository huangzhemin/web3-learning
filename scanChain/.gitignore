# ===================================
# Node.js 区块链扫链项目 .gitignore
# ===================================

# 依赖目录
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 环境变量文件（包含敏感信息）
.env
.env.local
.env.*.local
.env.development
.env.test
.env.staging
.env.production

# 日志文件
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 运行时数据
pids/
*.pid
*.seed
*.pid.lock

# 测试覆盖率
coverage/
*.lcov
.nyc_output/

# 构建输出
dist/
build/
out/

# 临时文件
.tmp/
.temp/
temp/
tmp/

# 操作系统文件
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE 和编辑器
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-*

# ===================================
# 区块链特定文件
# ===================================

# 私钥和敏感信息（绝对不要提交！）
*.pem
*.key
*.keystore
mnemonic.txt
private-key.txt
.secrets
.secrets.json
secrets.json

# 本地区块链节点数据
chaindata/
geth/
parity/
besu/
testnet/
ganache/
hardhat-node/

# 编译输出和缓存
artifacts/
cache/
typechain/
typechain-types/

# 部署配置
deployments/
hardhat-deployments/

# 本地数据库
*.db
*.sqlite
*.sqlite3

# 区块链扫描器缓存
scanner-cache/
block-cache/
transaction-cache/
address-cache/
tx-cache/

# 本地配置文件
config.local.js
config.local.json
local.config.js
local.env

# 测试结果和输出
test-results/
test-output/
test-env/
test-data/

# 性能分析文件
.prof
.cpuprofile
.heapprofile

# 错误报告
error-reports/
crash-reports/

# 监控和日志
monitoring/
*.log.*

# 备份文件
backup/
archive/
*.bak
*.backup
*.old

# 压缩文件
*.zip
*.tar.gz
*.rar

# 本地开发工具配置
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json

# 网络配置
.netrc
.netrc.*

# 证书文件
*.crt
*.p12
*.pfx

# 性能测试结果
performance-results/
benchmark-results/

# 安全扫描结果
security-scan-results/
vulnerability-reports/

# 合约验证
verification/
contract-verification/

# 部署脚本
deploy-scripts/
deployment-scripts/

# 本地开发服务器
.local/
dev-server/

# 文档构建
docs/build/

# PM2 进程管理
.pm2/
.pid

# 可选：依赖锁定文件（取决于团队策略）
# package-lock.json
# yarn.lock

# 可选：npm 缓存
.npm

# 可选：ESLint 缓存
.eslintcache

# 可选：REPL 历史
.node_repl_history 